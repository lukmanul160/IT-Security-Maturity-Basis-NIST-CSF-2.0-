NODE_ENV=development
PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nist_basis
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# Opsional: path lengkap pg_dump jika tidak tersedia di PATH Windows
# PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe
# PG_RESTORE_PATH=C:\\Program Files\\PostgreSQL\\16\\bin\\pg_restore.exe
# Opsional: connection string pool aplikasi dan tools backup
# Startup/provisioning tetap memakai DB_*; kedua konfigurasi wajib menunjuk target yang sama.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nist_basis

# Pilih storage/bucket melalui Account > Storage Setting.
# AWS: gunakan IAM role atau kredensial environment server berikut.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Google Cloud: service account runtime atau Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/google-service-account.json
