# Copy to .env.docker. Choose your own long, random database password.
BLACKOWL_DB_PASSWORD=
# Replace with the VM IP. No scheme, slash or port.
BLACKOWL_ADDRESS=192.168.130.12
BLACKOWL_BIND_IP=0.0.0.0
# IP default: local CA generated by the Nginx startup script; trust root.crt on clients.
# Own domain SSL: change ADDRESS and enable the certificate lines in
# deploy/nginx/templates/default.conf.template. See docs/DOCKER_HTTPS.md.
