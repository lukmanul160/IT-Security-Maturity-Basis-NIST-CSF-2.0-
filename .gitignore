upload/*
backup/*
!upload/.gitkeep
node_modules/
data/smtp-secret.key
data/audit-pending/
.env
.key
.env.*
npm-debug.log*

# Generated Vue workspace artifacts are recreated by prepare:client.
frontend/client/src/workspace/generated/

# Operational risk data must remain local and must never be committed.
Cybersecurity Risk Register.xlsx
*Risk*Register*.xlsx

# Local screenshots may contain confidential company information.
/output/**/*.png
/img/*.png

/frontend/public/landing-media/

# Local TLS certificates and private keys; never commit deployment secrets.
/deploy/nginx/certs/*
!/deploy/nginx/certs/.gitkeep
